# Stamp — Environment Variables
# Copy this to .env and fill in real values

# Database (MySQL 8.0, mysql2 connection string)
DATABASE_URL=mysql://user:password@host:3306/stamp

# Session signing secret (at least 32 random bytes, base64 or hex)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# OTP SMS provider (MSG91, 2Factor, etc.)
OTP_PROVIDER_URL=https://api.msg91.com/api/v5/otp
OTP_PROVIDER_KEY=your-api-key-here
OTP_SENDER_ID=STAMPD

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Base URL of the deployed app (no trailing slash)
BASE_URL=https://your-domain.com

# Comma-separated phone numbers of admin users (E.164 format, e.g. +919876543210)
ADMIN_PHONES=+919876543210

# Secret header value for cron endpoint
CRON_SECRET=change-me-to-another-random-string

# Node environment
NODE_ENV=development
PORT=3000

