---
/**
 * index.astro — Home page: all 14 sections.
 * Copy comes from content/home.ts, never hard-coded.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import PlaceholderImage from '@/components/PlaceholderImage.astro';
import ScribbleUnderline from '@/components/ScribbleUnderline.astro';
import StampMark from '@/components/StampMark.astro';
import TicketCard from '@/components/TicketCard.astro';
import { site } from '@/config/site';
import {
  hero, problem, howItWorks, benefits, scratchDemo,
  customerBenefits, security, dashboard, audience,
  pilot, onTheWay, faq, finalCta,
} from '@/content/home';

const waLink = `https://wa.me/${site.whatsapp.replace('+', '')}?text=${encodeURIComponent(site.whatsappMessage)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: site.name,
      url: `https://${site.domain}`,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.phone,
        contactType: 'customer service',
      },
    },
    {
      '@type': 'WebSite',
      name: site.name,
      url: `https://${site.domain}`,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.items.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={site.name}
  description={hero.sub}
  jsonLd={jsonLd}
  pageClass="page-home"
>

  <!-- §1 HERO ──────────────────────────────────────────────── -->
  <section class="hero section" aria-labelledby="hero-heading">
    <div class="hero__inner container">
      <div class="hero__text">
        <h1 id="hero-heading" class="hero__headline t-display">
          Paper stamp cards,<br/>without the <ScribbleUnderline>paper</ScribbleUnderline>.
        </h1>
        <p class="hero__sub">{hero.sub}</p>
        <div class="hero__actions">
          <a href={hero.primaryCta.href} class="btn btn--primary">{hero.primaryCta.label}</a>
          <a href={hero.secondaryCta.href} class="btn btn--secondary">{hero.secondaryCta.label}</a>
        </div>
        <ul class="hero__facts" role="list">
          {hero.facts.map(fact => (
            <li class="hero__fact">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.5 3L13 5" stroke="var(--c-success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{fact}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero__visual">
        <TicketCard tilt={1.2} class="hero__ticket">
          <div class="hero__card-mockup">
            <div class="hero__card-header">
              <span class="t-mono">Stamp Card</span>
              <span class="t-mono hero__card-shop">Ravi's Chai</span>
            </div>
            <div class="hero__stamps-grid">
              {Array.from({ length: 8 }).map((_, i) => (
                <div class:list={['hero__stamp-slot', i < 4 && 'hero__stamp-slot--filled']}>
                  {i < 4 ? (
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                      <circle cx="14" cy="14" r="11" fill="var(--c-violet)" opacity="0.15"/>
                      <circle cx="14" cy="14" r="11" stroke="var(--c-violet)" stroke-width="1.5" fill="none" opacity="0.7"/>
                      <path d="M9 14.5l3 3 7-7" stroke="var(--c-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  ) : (
                    <span class="hero__stamp-empty">{i + 1}</span>
                  )}
                </div>
              ))}
            </div>
            <div class="hero__card-reward t-mono">
              Reward: Free chai ☕
            </div>
          </div>
        </TicketCard>
        <div class="hero__stamp-landing" id="hero-stamp" aria-hidden="true">
          <StampMark size={64} text="✓" rotation={-5} animate={true} id="hero" />
        </div>
        <PlaceholderImage id="hero-counter" class="hero__photo" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- §2 PROBLEM STATEMENT ─────────────────────────────────── -->
  <section class="problem section" aria-label="The problem with paper cards">
    <div class="problem__inner container container--narrow">
      <p class="problem__sentence" id="problem-text">
        {problem.sentence}
      </p>
    </div>
  </section>

  <!-- §3 HOW IT WORKS ──────────────────────────────────────── -->
  <SectionDivider label={howItWorks.label} id="how-it-works" />
  <section class="steps section" aria-labelledby="steps-heading">
    <div class="steps__inner container">
      <h2 id="steps-heading" class="sr-only">How it works</h2>
      <div class="steps__layout">
        <div class="steps__phone-col">
          <div class="steps__phone-frame" id="steps-phone">
            <div class="steps__phone-screen">
              {howItWorks.steps.map((step, i) => (
                <div class:list={['steps__screen-img', i === 0 && 'steps__screen-img--active']} data-step-screen={i}>
                  <PlaceholderImage id={step.screen} />
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="steps__text-col">
          {howItWorks.steps.map((step, i) => (
            <div class:list={['steps__step', i === 0 && 'steps__step--active']} data-step-index={i}>
              <div class="steps__step-marker">
                <span class="steps__step-number t-mono">{step.number}</span>
                <div class="steps__step-rail">
                  <div class="steps__step-progress"></div>
                </div>
              </div>
              <div class="steps__step-content">
                <h3 class="steps__step-title">{step.title}</h3>
                <p class="steps__step-desc">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- §4 BENEFITS ──────────────────────────────────────────── -->
  <SectionDivider label={benefits.label} />
  <section class="benefits section" aria-labelledby="benefits-heading">
    <div class="benefits__inner container">
      <h2 id="benefits-heading" class="sr-only">Benefits for shopkeepers</h2>
      <div class="benefits__grid">
        {benefits.items.map((item, i) => (
          <div
            class:list={['benefits__item', item.isLead && 'benefits__item--lead']}
            data-animate-in
            style={`--stagger: ${i * 60}ms`}
          >
            {item.isLead && item.image && (
              <PlaceholderImage id={item.image} class="benefits__lead-img" />
            )}
            <h3 class="benefits__title">{item.title}</h3>
            <p class="benefits__desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- §5 SCRATCH DEMO ──────────────────────────────────────── -->
  <SectionDivider label={scratchDemo.label} />
  <section class="scratch section" aria-labelledby="scratch-heading">
    <div class="scratch__inner container">
      <h2 id="scratch-heading" class="scratch__headline">{scratchDemo.headline}</h2>
      <TicketCard tilt={-0.8} class="scratch__card">
        <div class="scratch__demo-area">
          <canvas
            class="scratch__canvas"
            id="scratch-canvas"
            width="320"
            height="200"
            role="img"
            aria-label="Scratch card demo — scratch to reveal a surprise reward"
          ></canvas>
          <div class="scratch__prize" id="scratch-prize" aria-live="polite">
            🎉 Free chai on your next visit!
          </div>
          <button class="btn btn--ghost scratch__reveal-btn" id="scratch-reveal" type="button">
            Reveal
          </button>
          <p class="scratch__caption t-mono">{scratchDemo.caption}</p>
        </div>
      </TicketCard>
    </div>
  </section>

  <!-- §6 FOR YOUR CUSTOMERS ────────────────────────────────── -->
  <SectionDivider label={customerBenefits.label} />
  <section class="customers section" aria-labelledby="customers-heading">
    <div class="customers__inner container">
      <h2 id="customers-heading" class="customers__heading">What your customers get</h2>
      <div class="customers__layout">
        <PlaceholderImage id={customerBenefits.image} class="customers__img" />
        <ul class="customers__list" role="list">
          {customerBenefits.items.map(item => (
            <li class="customers__item">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <circle cx="9" cy="9" r="7" stroke="var(--c-violet)" stroke-width="1.5" fill="var(--c-violet-tint)"/>
                <path d="M6 9.5l2 2 4-4" stroke="var(--c-violet)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- §7 FAIR AND SECURE ───────────────────────────────────── -->
  <SectionDivider label={security.label} />
  <section class="secure section" aria-labelledby="secure-heading">
    <div class="secure__inner container">
      <h2 id="secure-heading" class="secure__heading">Fair and secure</h2>
      <div class="secure__layout">
        <ul class="secure__list" role="list">
          {security.features.map(feat => (
            <li class="secure__item">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M9 2L3 5v4c0 4 2.5 7 6 8 3.5-1 6-4 6-8V5l-6-3z" stroke="var(--c-violet)" stroke-width="1.5" fill="var(--c-violet-tint)"/>
              </svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
        <div class="secure__qr-demo">
          <div class="secure__qr-frame" id="qr-demo-container">
            <canvas id="qr-canvas" width="200" height="200"></canvas>
            <div class="secure__qr-countdown" id="qr-countdown"></div>
          </div>
          <p class="secure__qr-caption t-mono">{security.qrCaption}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- §8 DASHBOARD PREVIEW ─────────────────────────────────── -->
  <SectionDivider label={dashboard.label} />
  <section class="ledger section" aria-labelledby="ledger-heading">
    <div class="ledger__inner container">
      <h2 id="ledger-heading" class="ledger__heading">{dashboard.headline}</h2>
      <div class="ledger__table-wrap">
        <table class="ledger__table" aria-label="Sample shop dashboard">
          <thead>
            <tr>
              <th class="t-mono">Time</th>
              <th class="t-mono">Event</th>
              <th class="t-mono">Customer</th>
              <th class="t-mono">Status</th>
            </tr>
          </thead>
          <tbody id="ledger-body">
            {dashboard.sampleRows.map((row, i) => (
              <tr class="ledger__row" data-ledger-row={i} style={`--row-delay: ${i * 150}ms`}>
                <td class="t-mono">{row.time}</td>
                <td>{row.event}</td>
                <td>{row.customer}</td>
                <td class="ledger__status">{row.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="ledger__disclaimer t-mono">{dashboard.disclaimer}</p>
      </div>
    </div>
  </section>

  <!-- §9 WHO IT IS FOR ─────────────────────────────────────── -->
  <SectionDivider label={audience.label} />
  <section class="audience section" aria-labelledby="audience-heading">
    <div class="audience__inner container">
      <h2 id="audience-heading" class="audience__heading">Who it is for</h2>
      <p class="audience__types">
        {audience.shopTypes.join(' · ')}
      </p>
      <div class="audience__images">
        {audience.images.map((id, i) => (
          <PlaceholderImage id={id} class:list={['audience__img', i === 1 && 'audience__img--offset']} />
        ))}
      </div>
    </div>
  </section>

  <!-- §10 START WITH A FREE PILOT ──────────────────────────── -->
  <section class="pilot section" aria-labelledby="pilot-heading">
    <div class="pilot__inner container">
      <h2 id="pilot-heading" class="pilot__heading">{pilot.headline}</h2>
      <ol class="pilot__steps" role="list">
        {pilot.steps.map((step, i) => (
          <li class="pilot__step" data-animate-in style={`--stagger: ${i * 100}ms`}>
            <span class="pilot__step-num t-mono">{i + 1}</span>
            <span class="pilot__step-text">{step}</span>
          </li>
        ))}
      </ol>
      {site.pricing.visible ? (
        <div class="pilot__pricing">
          {/* Pricing cards would render here */}
        </div>
      ) : (
        <p class="pilot__fallback">{pilot.fallbackText}</p>
      )}
      <div class="pilot__actions">
        <a href="/contact" class="btn btn--primary">Start a free pilot</a>
        <a href={waLink} class="btn btn--whatsapp" target="_blank" rel="noopener noreferrer">
          WhatsApp us
        </a>
      </div>
    </div>
  </section>

  <!-- §11 ON THE WAY ───────────────────────────────────────── -->
  <section class="roadmap section" aria-labelledby="roadmap-heading">
    <div class="roadmap__inner container container--narrow">
      <h2 id="roadmap-heading" class="roadmap__heading t-mono">{onTheWay.label}</h2>
      <ul class="roadmap__list" role="list">
        {onTheWay.items.map(item => (
          <li class="roadmap__item t-small">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- §12 FAQ ──────────────────────────────────────────────── -->
  <SectionDivider label={faq.label} />
  <section class="faq section" aria-labelledby="faq-heading">
    <div class="faq__inner container container--narrow">
      <h2 id="faq-heading" class="faq__heading">Common questions</h2>
      {faq.items.map(item => (
        <details class="faq__item">
          <summary class="faq__question">{item.q}</summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- §13 FINAL CTA ────────────────────────────────────────── -->
  <section class="final-cta" aria-labelledby="final-cta-heading">
    <div class="final-cta__inner container">
      <h2 id="final-cta-heading" class="final-cta__headline">{finalCta.headline}</h2>
      <div class="final-cta__actions">
        <a href={waLink} class="btn btn--whatsapp btn--final" target="_blank" rel="noopener noreferrer">
          {finalCta.whatsappLabel}
        </a>
        <a href="/contact" class="btn btn--secondary btn--final-secondary">{finalCta.pilotLabel}</a>
      </div>
      <div class="final-cta__stamp" id="final-stamp">
        <StampMark size={96} text="✓" rotation={-4} animate={true} id="final" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ================================================================
     HOME PAGE STYLES
     ================================================================ */

  /* --- §1 HERO ----------------------------------------------- */
  .hero {
    padding-top: calc(var(--header-height) + var(--s-8));
    padding-bottom: var(--s-7);
    overflow: visible;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-7);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--s-8);
    }
  }

  .hero__headline {
    margin-bottom: var(--s-5);
    max-width: 14ch;
  }

  .hero__sub {
    font-size: clamp(1.0625rem, 0.3vw + 1rem, 1.1875rem);
    color: var(--c-ink-muted);
    max-width: 48ch;
    margin-bottom: var(--s-6);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }

  .hero__facts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
  }

  .hero__fact {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--f-small);
    color: var(--c-ink-muted);
    margin: 0;
  }

  /* Hero visual */
  .hero__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__ticket {
    position: relative;
    z-index: 2;
    max-width: 320px;
    width: 100%;
  }

  .hero__photo {
    margin-top: calc(var(--s-6) * -1);
    position: relative;
    z-index: 1;
    max-width: 360px;
    width: 100%;
  }

  @media (min-width: 64rem) {
    .hero__photo {
      margin-top: calc(var(--s-8) * -1);
      max-width: 420px;
    }
  }

  .hero__stamp-landing {
    position: absolute;
    top: 0;
    right: 10%;
    z-index: 3;
  }

  /* Card mockup */
  .hero__card-mockup {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .hero__card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hero__card-shop {
    color: var(--c-violet);
    font-weight: 600;
  }

  .hero__stamps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-2);
  }

  .hero__stamp-slot {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px dashed var(--c-hairline);
    border-radius: var(--r-sm);
    background: var(--c-page);
  }

  .hero__stamp-slot--filled {
    border-style: solid;
    border-color: var(--c-violet-tint);
    background: var(--c-violet-tint);
  }

  .hero__stamp-empty {
    font-family: var(--ff-mono);
    font-size: 0.6875rem;
    color: var(--c-hairline);
  }

  .hero__card-reward {
    color: var(--c-ink-muted);
    font-size: 0.75rem;
    text-align: center;
    padding-top: var(--s-2);
    border-top: 1px solid var(--c-hairline);
  }

  /* --- §2 PROBLEM -------------------------------------------- */
  .problem {
    padding-block: var(--s-10);
  }

  .problem__sentence {
    font-family: var(--ff-display);
    font-size: var(--f-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 24ch;
    color: var(--c-ink);
  }

  /* Word-level scroll opacity — each word wrapped by script */
  .problem__sentence :global(.word) {
    opacity: 0.2;
    transition: opacity 0.15s var(--ease-out);
  }

  .problem__sentence :global(.word.visible) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .problem__sentence :global(.word) {
      opacity: 1;
    }
  }

  /* --- §3 HOW IT WORKS --------------------------------------- */
  .steps__inner {
    /* nothing special at mobile */
  }

  .steps__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  @media (min-width: 64rem) {
    .steps__layout {
      grid-template-columns: 0.4fr 0.6fr;
      gap: var(--s-8);
    }
  }

  /* Phone frame */
  .steps__phone-col {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .steps__phone-col {
      position: sticky;
      top: calc(var(--header-height) + var(--s-6));
      align-self: start;
    }
  }

  .steps__phone-frame {
    width: 220px;
    border: 2px solid var(--c-ink);
    border-radius: 24px;
    padding: 8px;
    background: var(--c-surface);
    position: relative;
    overflow: hidden;
  }

  .steps__phone-screen {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 9 / 19.5;
    background: var(--c-page);
  }

  .steps__screen-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }

  .steps__screen-img--active {
    opacity: 1;
  }

  /* Step items */
  .steps__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-3);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--c-hairline);
    opacity: 0.4;
    transition: opacity 0.3s var(--ease-out);
  }

  .steps__step--active {
    opacity: 1;
  }

  .steps__step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
  }

  .steps__step-number {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--c-hairline);
    border-radius: 50%;
    font-size: 0.75rem;
    color: var(--c-ink-muted);
    flex-shrink: 0;
  }

  .steps__step--active .steps__step-number {
    border-color: var(--c-violet);
    color: var(--c-violet);
    background: var(--c-violet-tint);
  }

  .steps__step-rail {
    width: 2px;
    flex: 1;
    background: var(--c-hairline);
    border-radius: 1px;
    overflow: hidden;
  }

  .steps__step-progress {
    width: 100%;
    height: 0%;
    background: var(--c-violet);
    transition: height 0.4s var(--ease-out);
  }

  .steps__step--active .steps__step-progress {
    height: 100%;
  }

  .steps__step-title {
    font-size: var(--f-h3);
    margin-bottom: var(--s-2);
  }

  .steps__step-desc {
    color: var(--c-ink-muted);
    font-size: var(--f-small);
    max-width: 48ch;
  }

  @media (min-width: 64rem) {
    .steps__step {
      min-height: 70vh;
      padding: var(--s-7) 0;
    }
  }

  /* --- §4 BENEFITS ------------------------------------------- */
  .benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  @media (min-width: 40rem) {
    .benefits__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 64rem) {
    .benefits__grid {
      grid-template-columns: 1.4fr 0.6fr;
      gap: var(--s-5);
    }

    /* Lead item spans full left */
    .benefits__item--lead {
      grid-row: 1 / 3;
    }

    /* After lead + 2 small items, switch to 3 columns */
    .benefits__item:nth-child(n+4) {
      grid-column: auto;
    }

    .benefits__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .benefits__item--lead {
      grid-column: 1 / 3;
      grid-row: auto;
    }
  }

  .benefits__item {
    padding: var(--s-5);
    background: var(--c-surface);
