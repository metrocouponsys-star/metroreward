<!-- Inline scripts for scroll interactions -->
<script is:inline>
(function () {
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- IntersectionObserver helper ---
  function onInView(selector, callback, options) {
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    const obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          callback(entry.target);
          if (options && options.once) obs.unobserve(entry.target);
        }
      });
    }, { threshold: options && options.threshold || 0.15 });
    els.forEach(function (el) { obs.observe(el); });
  }

  // --- 1. Hero stamp animation (700ms after load) ---
  setTimeout(function () {
    var heroStamp = document.querySelector('#hero-stamp .stamp-mark--animate');
    if (heroStamp) heroStamp.setAttribute('data-visible', 'true');
    // Also animate the scribble underline
    var scribble = document.querySelector('.scribble');
    if (scribble) scribble.setAttribute('data-visible', 'true');
  }, 700);

  // --- 2. Problem sentence word reveal ---
  if (!reducedMotion) {
    var problemEl = document.getElementById('problem-text');
    if (problemEl) {
      var text = problemEl.textContent || '';
      var words = text.trim().split(/\s+/);
      problemEl.innerHTML = words.map(function (w) {
        return '<span class="word">' + w + '</span>';
      }).join(' ');

      var wordEls = problemEl.querySelectorAll('.word');
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.5, rootMargin: '-10% 0px -10% 0px' });
      wordEls.forEach(function (w) { obs.observe(w); });
    }
  }

  // --- 3. How it works — step pinning ---
  var stepEls = document.querySelectorAll('[data-step-index]');
  var screenEls = document.querySelectorAll('[data-step-screen]');
  if (stepEls.length && screenEls.length) {
    var stepObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var idx = parseInt(entry.target.getAttribute('data-step-index'), 10);
          stepEls.forEach(function (s) { s.classList.remove('steps__step--active'); });
          screenEls.forEach(function (s) { s.classList.remove('steps__screen-img--active'); });
          entry.target.classList.add('steps__step--active');
          var screen = document.querySelector('[data-step-screen="' + idx + '"]');
          if (screen) screen.classList.add('steps__screen-img--active');
        }
      });
    }, { threshold: 0.4, rootMargin: '-30% 0px -30% 0px' });
    stepEls.forEach(function (s) { stepObs.observe(s); });
  }

  // --- 4. Generic animate-in (benefits, pilot steps) ---
  onInView('[data-animate-in]', function (el) {
    el.setAttribute('data-visible', 'true');
  }, { once: true, threshold: 0.1 });

  // --- 5. Ledger rows ---
  onInView('.ledger__row', function (el) {
    el.setAttribute('data-visible', 'true');
  }, { once: true, threshold: 0.1 });

  // --- 6. Stamp marks ---
  onInView('.stamp-mark--animate', function (el) {
    el.setAttribute('data-visible', 'true');
  }, { once: true, threshold: 0.4 });

})();
</script>

<!-- Scratch card demo -->
<script is:inline>
(function () {
  var canvas = document.getElementById('scratch-canvas');
  var revealBtn = document.getElementById('scratch-reveal');
  if (!canvas) return;

  var ctx = canvas.getContext('2d');
  if (!ctx) return;

  var w = canvas.width;
  var h = canvas.height;
  var isDrawing = false;

  // Draw the foil
  function drawFoil() {
    // Gold gradient
    var grad = ctx.createLinearGradient(0, 0, w, h);
    grad.addColorStop(0, '#C9A94E');
    grad.addColorStop(0.3, '#B8962E');
    grad.addColorStop(0.5, '#D4AD50');
    grad.addColorStop(0.7, '#B8962E');
    grad.addColorStop(1, '#A68526');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, w, h);

    // Subtle noise
    for (var i = 0; i < 3000; i++) {
      ctx.fillStyle = 'rgba(255,255,255,' + (Math.random() * 0.08) + ')';
      ctx.fillRect(Math.random() * w, Math.random() * h, 1, 1);
    }

    // Text
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.font = '600 18px ' + getComputedStyle(document.documentElement).getPropertyValue('--ff-display');
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('Scratch here ✨', w / 2, h / 2);
  }

  drawFoil();

  // Scratch
  function scratch(x, y) {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.beginPath();
    ctx.arc(x, y, 22, 0, Math.PI * 2);
    ctx.fill();
  }

  function getPos(e) {
    var rect = canvas.getBoundingClientRect();
    var scaleX = w / rect.width;
    var scaleY = h / rect.height;
    if (e.touches && e.touches[0]) {
      return {
        x: (e.touches[0].clientX - rect.left) * scaleX,
        y: (e.touches[0].clientY - rect.top) * scaleY,
      };
    }
    return {
      x: (e.clientX - rect.left) * scaleX,
      y: (e.clientY - rect.top) * scaleY,
    };
  }

  canvas.addEventListener('mousedown', function (e) { isDrawing = true; scratch(getPos(e).x, getPos(e).y); });
  canvas.addEventListener('mousemove', function (e) { if (isDrawing) scratch(getPos(e).x, getPos(e).y); });
  canvas.addEventListener('mouseup', function () { isDrawing = false; });
  canvas.addEventListener('mouseleave', function () { isDrawing = false; });
  canvas.addEventListener('touchstart', function (e) { e.preventDefault(); isDrawing = true; var p = getPos(e); scratch(p.x, p.y); }, { passive: false });
  canvas.addEventListener('touchmove', function (e) { e.preventDefault(); if (isDrawing) { var p = getPos(e); scratch(p.x, p.y); } }, { passive: false });
  canvas.addEventListener('touchend', function () { isDrawing = false; });

  // Reveal button for keyboard / reduced motion
  if (revealBtn) {
    revealBtn.addEventListener('click', function () {
      ctx.clearRect(0, 0, w, h);
    });
  }
})();
</script>

<!-- QR demo -->
<script is:inline>
(function () {
  var container = document.getElementById('qr-demo-container');
  var canvas = document.getElementById('qr-canvas');
  if (!canvas || !container) return;

  // Simple QR-like pattern (we can't import the npm package in inline script)
  // Draw a fake QR pattern that changes
  var ctx = canvas.getContext('2d');
  if (!ctx) return;
  var size = 200;
  var cellSize = 10;
  var seed = 0;

  function mulberry32(a) {
    return function() {
      a |= 0; a = a + 0x6D2B79F5 | 0;
      var t = Math.imul(a ^ a >>> 15, 1 | a);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }

  function drawQR() {
    var rand = mulberry32(seed++);
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, size, size);

    ctx.fillStyle = 'var(--c-ink, #101820)';
    // Fixed position finders (corners)
    drawFinder(0, 0);
    drawFinder(size - 70, 0);
    drawFinder(0, size - 70);

    // Random data area
    for (var x = 80; x < size - 10; x += cellSize) {
      for (var y = 80; y < size - 10; y += cellSize) {
        if (rand() > 0.5) {
          ctx.fillRect(x, y, cellSize - 1, cellSize - 1);
        }
      }
    }
    // Fill remaining areas
    for (var x2 = 80; x2 < size - 10; x2 += cellSize) {
      for (var y2 = 10; y2 < 70; y2 += cellSize) {
        if (rand() > 0.5) {
          ctx.fillRect(x2, y2, cellSize - 1, cellSize - 1);
        }
      }
    }
    for (var x3 = 10; x3 < 70; x3 += cellSize) {
      for (var y3 = 80; y3 < size - 10; y3 += cellSize) {
        if (rand() > 0.5) {
          ctx.fillRect(x3, y3, cellSize - 1, cellSize - 1);
        }
      }
    }
  }

  function drawFinder(x, y) {
    ctx.fillStyle = '#101820';
    ctx.fillRect(x + 10, y + 10, 50, 50);
    ctx.fillStyle = '#fff';
    ctx.fillRect(x + 17, y + 17, 36, 36);
    ctx.fillStyle = '#101820';
    ctx.fillRect(x + 23, y + 23, 24, 24);
  }

  drawQR();
  setInterval(drawQR, 5000);
})();
</script>

