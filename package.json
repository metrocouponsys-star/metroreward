{
  "name": "stamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=server",
    "build:all": "npm run build --workspace=web && npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "build:site": "npm run build --workspace=site",
    "dev:site": "npm run dev --workspace=site",
    "check:placeholders": "npm run check:placeholders --workspace=site",
    "start": "node index.js",
    "test": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "workspaces": [
    "server",
    "web",
    "site"
  ],
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "concurrently": "^9.1.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.1",
    "esbuild": "^0.24.0",
    "fastify": "^5.4.0",
    "mysql2": "^3.11.5",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
