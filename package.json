{
  "name": "stamp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "build:site": "npm run build --workspace=site",
    "dev:site": "npm run dev --workspace=site",
    "check:placeholders": "npm run check:placeholders --workspace=site",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "workspaces": [
    "server",
    "web",
    "site"
  ],
  "dependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^18.0.9",
    "tsx": "^4.19.2"
  }
}
